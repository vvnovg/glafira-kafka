{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glafira for Apache Kafka",
  "mainBinaryName": "glafira-kafka",
  "version": "0.4.0",
  "identifier": "io.github.vvnovg.glafira.kafka",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Glafira for Apache Kafka",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "msi",
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Glafira for Apache Kafka",
    "category": "DeveloperTool",
    "shortDescription": "Glafira for Apache Kafka — desktop client for Apache Kafka",
    "copyright": "© 2026 Viacheslav Novgorodtsev",
    "linux": {
      "deb": {
        "depends": [
          "libsecret-1-0"
        ]
      },
      "rpm": {
        "depends": [
          "libsecret"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "wix": {
        "upgradeCode": "88add133-7053-419a-bc78-7d7ccb39333c",
        "language": [
          "en-US"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2MzYzRTZEQUUzOTFEQTIKUldTaUhUbXViVDQybHVERm5wemRya0F6YXFBUm1pMXdNbmFiNGk5dWtMdUxUOXBnNVhyOTBTUHkK",
      "endpoints": [
        "https://github.com/vvnovg/glafira-kafka-releases/releases/latest/download/latest.json"
      ]
    }
  }
}
